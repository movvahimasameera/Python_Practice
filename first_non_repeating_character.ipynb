   "source": [
    "def first_non_repeating(li):\n",
    "    d = {}\n",
    "\n",
    "    for i in li:\n",
    "        d[i] = d.get(i, 0) + 1\n",
    "\n",
    "    for i in li:\n",
    "        if d[i] == 1:\n",
    "            return i\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "li = \"programming\"\n",
    "print(first_non_repeating(li))"
   ]
  }
